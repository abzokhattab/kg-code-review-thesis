# Copy to .env and fill in. Load with:  source load_env.sh
# .env is git-ignored; never commit it.

# Required for anything that calls a model.
# Generator (gpt-4o), one of the five judges, and the embedding model
# (text-embedding-3-small) all use this key.
OPENAI_API_KEY=

# Required only to re-run the five-judge panel (one key per judge provider).
GOOGLE_API_KEY=        # gemini-2.5-flash
ANTHROPIC_API_KEY=     # claude-sonnet-4-5
DEEPSEEK_API_KEY=      # deepseek-v4-pro
XAI_API_KEY=           # grok-4.6

# Nothing is needed to recompute statistics or regenerate figures from the
# stored results — those scripts make no API calls.
