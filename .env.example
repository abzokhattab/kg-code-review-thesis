# Environment Variables for PR Note Generator
# Copy this file to .env and fill in your actual values

# ============================================
# LLM Provider Configuration
# ============================================

# Choose your provider: openai, anthropic, or local
MODEL_PROVIDER=openai

# Model name (examples below)
MODEL_NAME=gpt-4o

# ============================================
# API Keys
# ============================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Generic API Key (used if provider-specific key not set)
API_KEY=

# ============================================
# Model Options
# ============================================

# OpenAI Models:
# - gpt-4o (recommended, fast and good)
# - gpt-4-turbo
# - gpt-4
# - gpt-3.5-turbo

# Anthropic Models:
# - claude-3-7-sonnet-20250219 (recommended)
# - claude-3-5-sonnet-20241022
# - claude-3-opus-20240229
# - claude-3-sonnet-20240229
# - claude-3-haiku-20240307
